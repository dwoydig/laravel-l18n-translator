{
    "name": "dwoydig/l18n-translator",
    "description": "Laravel package to manage JSON language files via a web UI with optional DeepL auto-translation.",
    "keywords": ["laravel", "translation", "i18n", "l10n", "deepl", "json"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Woydig",
            "email": "dwoydig@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-intl": "*",
        "guzzlehttp/guzzle": "^7.5|^8.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.1|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Dwoydig\\L18nTranslator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dwoydig\\L18nTranslator\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dwoydig\\L18nTranslator\\TranslationServiceProvider"
            ],
            "aliases": {
                "DeepL": "Dwoydig\\L18nTranslator\\Facades\\DeepL"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "test:e2e": "npx playwright test"
    }
}
